---
import { stack } from '../data/stack';

const loop = [...stack, ...stack];
---

<div class="stack-marquee">
  <div class="stack-track">
    {
      loop.map((item, i) => (
        <div class="stack-item">
          <div class="icon-box">
            <img
              src={`https://cdn.simpleicons.org/${item.slug}`}
              alt={i < stack.length ? item.name : ''}
              loading="lazy"
            />
          </div>
          <span>{item.name}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .stack-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .icon-box {
    background: #f4f4f5;
    border-radius: var(--radius-md);
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-box img {
    height: 44px;
    width: 44px;
    object-fit: contain;
  }

  .stack-item span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
  }
</style>
