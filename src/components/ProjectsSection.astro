---
import type { Locale } from "../i18n/locales.js";
import { t } from "../i18n/ui.js";
import type { Project } from "../projects/types.js";
import MarginNotes from "./MarginNotes.astro";

// DESIGN.md: projects are comparable entries on the secondary surface,
// separated from the background by color, never by shadow.
interface Props {
  locale: Locale;
  projects: Project[];
}

const { locale, projects } = Astro.props;

const formatUpdated = (iso: string) =>
  new Intl.DateTimeFormat(locale, {
    dateStyle: "long",
    timeZone: "UTC",
  }).format(new Date(iso));
---

{
  projects.length > 0 && (
    <section id="projects" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="text-3xl font-semibold">
        {t(locale, "projectsHeading")}
      </h2>
      <ul class="mt-8 space-y-6">
        {projects.map((project) => (
          <li class="relative rounded-md bg-surface p-6">
            <h3 class="text-xl font-semibold">{project.title}</h3>
            <p class="mt-1">{project.summary}</p>
            <h4 class="mt-4 text-sm font-semibold">
              {t(locale, "projectStoryHeading")}
            </h4>
            <p class="mt-2">{project.story}</p>
            <dl class="mt-4 space-y-1">
              {project.github.language !== null && (
                <div class="flex gap-2">
                  <dt class="text-sm font-semibold">
                    {t(locale, "projectLanguage")}
                  </dt>
                  <dd>{project.github.language}</dd>
                </div>
              )}
              <div class="flex gap-2">
                <dt class="text-sm font-semibold">
                  {t(locale, "projectStars")}
                </dt>
                <dd>{project.github.stars}</dd>
              </div>
              <div class="flex gap-2">
                <dt class="text-sm font-semibold">
                  {t(locale, "projectUpdated")}
                </dt>
                <dd>
                  <time datetime={project.github.updatedAt}>
                    {formatUpdated(project.github.updatedAt)}
                  </time>
                </dd>
              </div>
            </dl>
            <p class="mt-3 flex flex-wrap gap-x-4">
              <a href={project.github.url}>
                <span class="sr-only">{project.title}: </span>
                {t(locale, "projectRepositoryLink")}
              </a>
              {project.github.homepage && (
                <a href={project.github.homepage}>
                  <span class="sr-only">{project.title}: </span>
                  {t(locale, "projectHomepageLink")}
                </a>
              )}
            </p>
            <MarginNotes notes={project.notes} />
          </li>
        ))}
      </ul>
    </section>
  )
}
