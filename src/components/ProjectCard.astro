---
import Card from './Card.astro';
import Badge from './Badge.astro';
import Tag from './Tag.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="reveal">
  <Card hoverable>
    <div class="head">
      <div class="title">{project.title}</div>
      <Badge tone="accent">En desarrollo</Badge>
    </div>
    <div class="tagline">{project.tagline}</div>
    <div class="description">{project.description}</div>
    <div class="tags">
      {project.stack.map((tech) => <Tag>{tech}</Tag>)}
    </div>
    <div class="links">
      <a href={project.github} target="_blank" rel="noopener">código →</a>
      {
        project.live && (
          <a href={project.live} target="_blank" rel="noopener">
            ver en vivo →
          </a>
        )
      }
    </div>
  </Card>
</div>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .title {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--text-primary);
  }

  .tagline {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin-top: 4px;
  }

  .description {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    margin-top: 14px;
    line-height: var(--lh-body);
  }

  .tags {
    display: flex;
    gap: 6px;
    margin-top: 16px;
    flex-wrap: wrap;
  }

  .links {
    display: flex;
    gap: 16px;
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
</style>
