// Cloudflare Workers with static assets (ADR-0035).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jsisques-net",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./dist",
  },
  "routes": [
    {
      "pattern": "jsisques.net",
      "custom_domain": true,
    },
  ],
  "workers_dev": true,
  "preview_urls": true,
  // Pull request Previews (ADR-0021). They never inherit production settings.
  "previews": {},
}
